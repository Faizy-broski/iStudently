{
  "expo": {
    "name": "Studently",
    "slug": "studently",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "studently",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ly.istudent.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Studently uses Face ID to unlock the app and to protect sensitive information.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ly.istudent.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Studently uses Face ID to unlock the app and to protect sensitive information."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Studently needs access to your photos to upload pictures such as profile photos, attachments and inspection evidence.",
          "cameraPermission": "Studently uses the camera to scan QR codes and to take photos for profiles, attachments and inspection evidence."
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Studently uses your location to set the school check-in area and to confirm on-site attendance.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Studently uses the microphone to record your reading in Speed Reading and voice notes during inspections.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Studently uses the microphone to record your reading in Speed Reading and voice notes during inspections.",
          "speechRecognitionPermission": "Studently checks the words you read aloud in Speed Reading."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Studently uses the camera to scan QR codes and to take photos for profiles, attachments and inspection evidence.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "locales": {
      "en": "./locales/en.json",
      "ar": "./locales/ar.json"
    }
  }
}
