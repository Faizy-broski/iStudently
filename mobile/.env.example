# Copy to .env. Public values only: never put the Supabase service-role key here.
EXPO_PUBLIC_API_URL=https://istudent.ly/api
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
